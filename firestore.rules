rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Accesso solo agli UID elencati in config/family.members (modificabile solo dalla Console).
    function isFamily() {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(db)/documents/config/family).data.members;
    }

    match /config/{doc} {
      allow read: if isFamily();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isFamily();
      allow write: if isFamily() && request.auth.uid == uid;
    }

    match /{col}/{id} {
      allow read, write: if isFamily() &&
        col in ['catalog_items', 'shopping_list', 'meals', 'weekly_plan'];
    }
  }
}
